# 飞书应用配置
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx

# 飞书多维表格 Token (从 URL 获取)
BASE_TOKEN=

# 表 ID (创建多维表格后填写)
CUSTOMER_TABLE_ID=
ORDER_TABLE_ID=
PRODUCT_TABLE_ID=
TASK_TABLE_ID=
TRANSFER_LOG_TABLE_ID=
DAILY_REPORT_TABLE_ID=
TARGET_TABLE_ID=
ORDER_DETAIL_TABLE_ID=
PREPAID_CUSTOMER_TABLE_ID=

# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 通知配置
ADMIN_USER_ID=ou_xxx  # 管理员飞书用户 ID

# 定时任务 (cron 表达式，默认每天早上9点)
CRON_SCHEDULE=0 9 * * *

# 日志级别
LOG_LEVEL=info