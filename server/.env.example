# Database
DATABASE_URL="mysql://root@localhost:3306/yimeihuifang"

# JWT
JWT_PRIVATE_KEY_PATH="./keys/private.pem"
JWT_PUBLIC_KEY_PATH="./keys/public.pem"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Feishu OAuth
FEISHU_APP_ID="cli_xxx"
FEISHU_APP_SECRET="xxx"
FEISHU_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# DeepSeek AI (for followup scripts)
DEEPSEEK_API_KEY="sk-xxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Feishu Base (read-only, for migration)
BASE_TOKEN=
CUSTOMER_TABLE_ID=
ORDER_TABLE_ID=
PRODUCT_TABLE_ID=
TASK_TABLE_ID=
TRANSFER_LOG_TABLE_ID=
DAILY_REPORT_TABLE_ID=
